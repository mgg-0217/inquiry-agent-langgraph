# ============================================================
# LLM 配置（OpenAI 兼容协议，可切换提供商）
# 复制本文件为 .env 后填入真实值
# ============================================================

# --- DeepSeek（默认）---
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- MiniMax（备选，需要时整段替换上面三行）---
# LLM_BASE_URL=https://api.minimax.cn/v1
# LLM_MODEL=MiniMax-M3.1-Flash
# LLM_API_KEY=xxxxxxxxxxxxxxxx

DATABASE_URL=sqlite:///./data/inquiry.db

AGENT_MODE=single
MAX_STEPS=15
MAX_TURNS=8
SPAM_THRESHOLD=0.85
SANCTION_REJECT_THRESHOLD=0.95
SANCTION_REVIEW_THRESHOLD=0.75

# 邮件 —— 开发期（Mailpit 本地）
MAIL_PROVIDER=mailpit
DRY_RUN=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=sales@example.com
# Mailpit HTTP API（v1.32 不支持 IMAP，拉原始邮件用这个）
MAILPIT_API_BASE=http://127.0.0.1:8025
IMAP_HOST=127.0.0.1
IMAP_PORT=2114
IMAP_POLL_INTERVAL=10

# 邮件 —— 真实邮箱（第 11 天联调时启用）
# MAIL_PROVIDER=imap
# IMAP_HOST=imap.qq.com
# IMAP_PORT=993
# IMAP_USER=your@qq.com
# IMAP_PASSWORD=授权码
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SEND_WHITELIST=your-other@example.com
# IMAP_POLL_INTERVAL=30

AUTH_SECRET_KEY=change-me
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=

QUOTE_VALID_DAYS=7
AUTO_REPLY_LIMIT=150000
DEFAULT_INCOTERM=FOB
